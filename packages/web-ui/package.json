      "optional": true
    }
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:"
  }
}
