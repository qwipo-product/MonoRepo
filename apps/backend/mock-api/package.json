{
  "name": "@mockups/mock-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Bun + Hono server that serves @mockups/mock-data over HTTP, so a mockup can fetch() instead of importing a fixture.",
  "scripts": {
    "dev": "PORT=8787 bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mockups/mock-data": "workspace:*",
    "@mockups/types": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
