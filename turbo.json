{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",

  // Bump any of these and every cached task is invalidated.
  "globalDependencies": ["bun.lock", "bunfig.toml", "flake.lock"],

  "tasks": {
    // `^build` = build every workspace dependency first. Shared packages here
    // ship raw TypeScript (no build step), so in practice this is a no-op —
    // it's declared so a package that *does* gain a build step later works
    // without anyone having to remember to wire the ordering up.
    "build": {
      "dependsOn": ["^build"],
      // dist/** for the Vite apps, storybook-static/** for the two catalogs.
      // Miss the second and a cache hit restores nothing, so the Docker build
      // COPYs an empty directory and nginx serves a 404 page with no error.
      "outputs": ["dist/**", "storybook-static/**"]
    },
    // `tsc --noEmit` produces nothing on disk — the cached artefact is the
    // pass/fail itself, so `outputs` is empty on purpose.
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    // Long-running: never cached, never "finishes".
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
