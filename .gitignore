# dependencies
node_modules/

# build output
dist/
build/
out/
# `storybook build` output. Regenerate with
# `bun run build --filter=@mockups/storybook[-web]` — it is not a source
# artefact, and its filenames are content-hashed, so committing it grows the
# repo on every build instead of replacing the previous copy.
storybook-static/

# tool caches
.turbo/
.cache/
*.tsbuildinfo
.eslintcache
.vite/

# Nix per-repo devshell cache (nix-direnv)
.direnv/

# env — never commit; copy .env.example instead
.env
.env.local
.env.*.local

# logs
*.log
logs/
bun-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# claude-flow tool state (daemon, metrics, neural, logs)
.claude-flow/
.swarm/
.hive-mind/
storybook-static/
