{
  "name": "@mockups/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Cross-platform product components composed from @mockups/ui primitives + @mockups/types (StatusBadge, ProductCard, …). Shared by every mockup. Ships raw TypeScript — no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mockups/types": "workspace:*",
    "@mockups/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
