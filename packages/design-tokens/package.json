{
  "name": "@mockups/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Platform-neutral design tokens (the single source of truth) with web (Tailwind theme.css) and React Native (theme.ts) bindings. Ships raw TypeScript — no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
