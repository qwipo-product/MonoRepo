{
  "name": "@mockups/mock-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The fake catalogue: products, sellers, orders, banners, addresses. Consumed by frontend mockups AND served by apps/backend/mock-api.",
