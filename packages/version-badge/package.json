{
  "name": "@mockups/version-badge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "The deployed-version pill every mockup shows in a corner, and the APP_VERSION constant behind it. Belongs to neither design kit. Raw TypeScript, no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./storybook": "./src/storybook.ts"
  },
  "scripts": {
