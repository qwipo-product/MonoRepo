{
  "name": "mockups-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": {
    "packages": [
      "apps/*/*",
      "packages/*"
    ],
    "catalog": {
      "@eslint/js": "10.0.1",
      "@tailwindcss/vite": "4.3.0",
      "@types/bun": "1.3.14",
      "@types/node": "25.9.3",
      "@types/react": "19.2.16",
      "@types/react-dom": "19.2.3",
      "@vercel/analytics": "2.0.1",
      "@vitejs/plugin-react": "6.0.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "eslint": "10.4.1",
      "eslint-plugin-react-hooks": "7.1.1",
      "eslint-plugin-react-refresh": "0.5.3",
      "globals": "17.6.0",
      "hono": "4.13.1",
      "lucide-react": "1.17.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.0",
      "typescript": "5.6.3",
      "typescript-eslint": "8.66.0",
      "vite": "8.0.16"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck build",
    "clean": "turbo run clean",
    "new": "bun run scripts/new-mockup.ts",
    "ls": "bun run scripts/list-apps.ts",
    "ci:install": "bun install --frozen-lockfile"
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "2.10.8",
    "typescript": "catalog:"
  }
}
