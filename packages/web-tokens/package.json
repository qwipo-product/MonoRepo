{
  "name": "@mockups/web-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Desktop/admin design tokens with the web (Tailwind theme.css) binding. Colour is re-exported from @mockups/design-tokens so the mobile and web layers cannot drift. Ships raw TypeScript — no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mockups/design-tokens": "workspace:*",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@mockups/eslint-config": "workspace:*",
    "@mockups/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
