{
  "name": "@mockups/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Shared React primitives, the cn() class composer, and the theme provider. Ships raw TypeScript — no build step.",
