{
  "name": "@mockups/web-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Desktop/admin React primitives (shadcn + Radix) and the app shell, for web mockups. The dense counterpart to @mockups/ui, which stays mobile-first. Ships raw TypeScript — no build step.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/components/*.tsx",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-alert-dialog": "catalog:",
    "@radix-ui/react-aspect-ratio": "catalog:",
